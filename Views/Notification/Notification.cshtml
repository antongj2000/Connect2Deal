@model List<Connect2Deal.Models.Notification>
@using Connect2Deal.Constants
@{
    ViewData["Title"] = "Notifications";
    ViewData["HideChrome"] = true;
}
<div class="c2d-shell" id="c2dShell">
    <partial name="_Sidebar" />
    <main class="c2d-main">
        <header class="c2d-topbar">
            <div class="c2d-topbar-left">
                <button class="c2d-burger" id="c2dBurger" aria-label="Toggle menu">
                    <span></span><span></span><span></span>
                </button>
                <div>
                    <h1 class="c2d-title">Notifications</h1>
                    <p class="c2d-subtitle">Your notifications</p>
                </div>
            </div>
        </header>
        @if (!Model.Any())
        {
            <div class="c2d-empty">
                <div class="c2d-empty-mark">✉</div>
                <h3>You don't have notifications</h3>
                <p>Notifications</p>
            </div>
        }
        else
        {
            <div class="c2d-inbox-list">
                @foreach (var n in Model)
                {
                    <div class="c2d-inbox-item">
                        <div class="c2d-inbox-avatar">✦</div>
                        <div class="c2d-inbox-info">
                            <div class="c2d-inbox-name @(n.IsRead ? "" : "is-unread")">
                                @n.Message
                            </div>
                            <div class="c2d-inbox-meta">
                                <span class="c2d-inbox-preview">
                                    @n.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                                </span>
                                @if (n.Type == NotificationTypes.RateSeller && !n.IsRead)
                                {
                                    <button type="button" class="c2d-notif-action" data-rate-tx="@n.RelatedId">
                                        Rate seller
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </main>
</div>

<div class="c2d-modal-overlay" id="rateModalOverlay">
    <div class="c2d-modal">
        <button class="c2d-modal-close" id="rateModalClose">&times;</button>
        <div id="rateModalContent"></div>
    </div>
</div>


@section Scripts {
    <script>
        (function () {
            const overlay = document.getElementById('rateModalOverlay');
            const content = document.getElementById('rateModalContent');
            const closeBtn = document.getElementById('rateModalClose');

            function openModal() {
                overlay.classList.add('is-open');
            }

            function closeModal() {
                overlay.classList.remove('is-open');
                content.innerHTML = '';
            }

            document.querySelectorAll('[data-rate-tx]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const txId = btn.dataset.rateTx;

                    content.innerHTML = '<div class="c2d-modal-loading">Loading…</div>';
                    openModal();

                    fetch('/UserRating/RateSeller?transactionId=' + txId)
                        .then(function (res) {
                            if (!res.ok) throw new Error('Failed to load');
                            return res.text();
                        })
                        .then(function (html) {
                            content.innerHTML = html;

                            // izvrši <script> iz partiala — innerHTML ga ne pokreće sam
                            content.querySelectorAll('script').forEach(function (oldScript) {
                                const newScript = document.createElement('script');
                                newScript.textContent = oldScript.textContent;
                                oldScript.replaceWith(newScript);
                            });
                        })
                        .catch(function () {
                            content.innerHTML = '<div class="c2d-modal-loading">Something went wrong.</div>';
                        });
                });
            });

            closeBtn.addEventListener('click', closeModal);

            overlay.addEventListener('click', function (e) {
                if (e.target === overlay) closeModal();
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeModal();
            });
        })();
    </script>
}