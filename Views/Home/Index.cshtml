@using System.Security.Claims
@model Connect2Deal.ViewModels.FilterListings
@{
    ViewData["Title"] = "Marketplace";
    ViewData["HideChrome"] = true;

    int? myId = User.Identity != null && User.Identity.IsAuthenticated
        ? int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier))
        : (int?)null;

    var savedIds = ViewData["SavedIds"] as List<int> ?? new List<int>();
    var activePage = ViewData["ActivePage"] as string ?? "";
}

<div class="c2d-shell" id="c2dShell">

    
    @Html.AntiForgeryToken()

<partial name="_Sidebar" />

    <main class="c2d-main">

        <div class="c2d-toolbar">
            <button class="c2d-burger" id="c2dBurger" aria-label="Toggle menu">
                <span></span><span></span><span></span>
            </button>

            @if (Model.Countries.Any())
            {
                <form class="c2d-filters" method="get" asp-controller="Home" asp-action="Index">

                    <input type="text" name="search" class="c2d-filter-search"
                           placeholder="Search listings..." value="@Model.Search" />

                    <select name="countryId" id="filterCountry" class="c2d-filter-select">
                        <option value="">All countries</option>
                        @foreach (var c in Model.Countries)
                        {
                            <option value="@c.Value" selected="@(Model.CountryId?.ToString() == c.Value)">@c.Text</option>
                        }
                    </select>

                    <select name="cityId" id="filterCity" class="c2d-filter-select">
                        <option value="">All cities</option>
                        @foreach (var c in Model.Cities)
                        {
                            <option value="@c.Value" selected="@(Model.CityId?.ToString() == c.Value)">@c.Text</option>
                        }
                    </select>

                    <select name="categoryId" id="filterCategory" class="c2d-filter-select">
                        <option value="">All categories</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Value" selected="@(Model.CategoryId?.ToString() == c.Value)">@c.Text</option>
                        }
                    </select>

                    <select name="subcategoryId" id="filterSubcategory" class="c2d-filter-select">
                        <option value="">All subcategories</option>
                        @foreach (var c in Model.Subcategories)
                        {
                            <option value="@c.Value" selected="@(Model.SubcategoryId?.ToString() == c.Value)">@c.Text</option>
                        }
                    </select>

                    <button type="submit" class="c2d-filter-btn">Search</button>
                    <a class="c2d-filter-reset" asp-controller="Home" asp-action="Index">Reset</a>

                </form>
            }
        </div>

        <div class="c2d-section-head">
            <h2 class="c2d-section-title">Latest listings</h2>
            <span class="c2d-count">@Model.Listings.Count total</span>
        </div>

        @if (!Model.Listings.Any())
        {
            <div class="c2d-empty">
                <div class="c2d-empty-mark">▤</div>
                <h3>Nothing here yet</h3>
                <p>Be the first to post something. Your listing shows up right here.</p>
                <a class="c2d-cta" asp-controller="Listing" asp-action="CreateListing">
                    <span>＋</span> Post the first listing
                </a>
            </div>
        }
        else
        {
            <div class="c2d-grid">
                @foreach (var listing in Model.Listings)
                {
                    var cat = listing.Category?.Name ?? "Other";
                    var hue = System.Math.Abs(cat.GetHashCode()) % 360;
                    var thumb = listing.ListingImages?.FirstOrDefault(i => i.IsPrimary)
                    ?? listing.ListingImages?.FirstOrDefault();
                    var isSaved = savedIds.Contains(listing.Id);
                    var isInactive = listing.Status != "Active";
                    var canMarkSold = activePage == "MyListings"
                    && listing.UserId == myId
                    && listing.Status == "Active";

                    <article class="c2d-listing @(isInactive ? "c2d-listing-inactive" : "")">
                        <div class="c2d-thumb" style="--h:@hue">
                            @if (thumb != null)
                            {
                                <img src="@thumb.ImagePath" alt="@listing.Title"
                                     style="position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover;" />
                            }
                            else
                            {
                                <span class="c2d-thumb-initial">@cat.Substring(0, 1)</span>
                            }
                            <span class="c2d-thumb-badge">@cat</span>
                            <span class="c2d-thumb-price">@(listing.Price?.ToString("N0") ?? "0") €</span>
                        </div>

                        <div class="c2d-listing-body">
                            <h3 class="c2d-listing-title">@listing.Title</h3>

                            <div class="c2d-meta">
                                <span class="c2d-meta-loc">◍ @(listing.Location?.Name ?? "—")</span>
                                <span class="c2d-meta-dot">·</span>
                                <span class="c2d-meta-date">@listing.CreatedAt.ToString("dd MMM")</span>
                            </div>

                            <div class="c2d-listing-foot">
                                <button class="c2d-view" data-detail-id="@listing.Id">
                                    View details
                                </button>

                                @if (canMarkSold)
                                {
                                    <button class="c2d-sold-btn"
                                            data-sold-id="@listing.Id"
                                            title="Označi kao prodato"
                                            onclick="event.stopPropagation();">
                                        Mark as sold
                                    </button>
                                }

                                @if (myId != null && listing.UserId != myId)
                                {
                                    <button class="c2d-fav-btn @(isSaved ? "is-saved" : "")"
                                            data-listing-id="@listing.Id"
                                            title="Save listing"
                                            onclick="event.stopPropagation();">
                                        <svg viewBox="0 0 24 24" width="20" height="20"
                                             fill="@(isSaved ? "currentColor" : "none")"
                                             stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                        </svg>
                                    </button>
                                }

                                @if (myId != null && listing.UserId != myId)
                                {
                                    <button type="button" class="c2d-msg-btn"
                                            data-msg-listing="@listing.Id"
                                            title="Message seller"
                                            onclick="event.stopPropagation();">
                                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                                        </svg>
                                    </button>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </main>

    <!-- ============ DETAIL MODAL ============ -->
    <div class="c2d-modal-overlay" id="c2dModal">
        <div class="c2d-modal">
            <button class="c2d-modal-close" id="c2dModalClose">✕</button>
            <div class="c2d-modal-content" id="c2dModalContent">
                <!-- the listing detail partial loads in here -->
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        (function () {
            const modal      = document.getElementById('c2dModal');
            const modalBody  = document.getElementById('c2dModalContent');

            // ---- ubacuje HTML u modal I izvršava skripte iz njega ----
            function setModalContent(html) {
                modalBody.innerHTML = html;
                modalBody.querySelectorAll('script').forEach(function (old) {
                    const s = document.createElement('script');
                    s.textContent = old.textContent;
                    old.replaceWith(s);
                });
            }

            window.c2dSetModalContent = setModalContent;

            function openModal() {
                modal.classList.add('is-open');
                document.body.style.overflow = 'hidden';
            }

            // ---- ulančavanje: država -> gradovi, kategorija -> podkategorije ----
            const countrySel = document.getElementById('filterCountry');
            const citySel    = document.getElementById('filterCity');
            const catSel     = document.getElementById('filterCategory');
            const subSel     = document.getElementById('filterSubcategory');

            async function fillChildren(parentId, targetSelect, url, emptyLabel) {
                targetSelect.innerHTML = '<option value="">' + emptyLabel + '</option>';
                if (!parentId) return;

                const response = await fetch(url + parentId);
                if (!response.ok) return;

                const items = await response.json();
                items.forEach(function (i) {
                    const opt = document.createElement('option');
                    opt.value = i.id;
                    opt.textContent = i.name;
                    targetSelect.appendChild(opt);
                });
            }

            if (countrySel) {
                countrySel.addEventListener('change', function () {
                    fillChildren(countrySel.value, citySel, '/Home/GetCities?countryId=', 'All cities');
                });
            }

            if (catSel) {
                catSel.addEventListener('change', function () {
                    fillChildren(catSel.value, subSel, '/Home/GetSubcategories?categoryId=', 'All subcategories');
                });
            }

            // ---- listing detail modal (otvaranje) ----
            document.querySelectorAll('[data-detail-id]').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const id = btn.getAttribute('data-detail-id');

                    modalBody.innerHTML = '<div class="c2d-modal-loading">Loading...</div>';
                    openModal();

                    const response = await fetch(`/Listing/ListingDetails/${id}`);
                    setModalContent(response.ok
                        ? await response.text()
                        : '<div class="c2d-modal-loading">Listing not found.</div>');
                });
            });

            // ---- message seller (otvara modal sa porukom) ----
            document.querySelectorAll('[data-msg-listing]').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const id = btn.getAttribute('data-msg-listing');

                    modalBody.innerHTML = '<div class="c2d-modal-loading">Loading...</div>';
                    openModal();

                    const response = await fetch(`/Chat/MessageSeller?listingId=${id}`);
                    setModalContent(response.ok
                        ? await response.text()
                        : '<div class="c2d-modal-loading">Could not load.</div>');
                });
            });

            // ---- mark as sold (otvara modal sa listom kupaca) ----
            document.querySelectorAll('[data-sold-id]').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const id = btn.getAttribute('data-sold-id');

                    modalBody.innerHTML = '<div class="c2d-modal-loading">Loading...</div>';
                    openModal();

                    const response = await fetch(`/Listing/SelectBuyer?listingId=${id}`);
                    setModalContent(response.ok
                        ? await response.text()
                        : '<div class="c2d-modal-loading">Could not load.</div>');

                    if (response.ok) {
                        wireBuyerPicker();
                    }
                });
            });

            // ---- izbor kupca (radi na sadržaju ubačenom u modal) ----
            function wireBuyerPicker() {
                let selectedBuyerId = null;

                const items = modalBody.querySelectorAll('.c2d-buyer-item');
                const confirmBtn = modalBody.querySelector('#c2dBuyerConfirm');

                items.forEach(item => {
                    item.addEventListener('click', () => {
                        items.forEach(i => i.classList.remove('is-picked'));
                        item.classList.add('is-picked');
                        selectedBuyerId = item.getAttribute('data-buyer-id');
                        if (confirmBtn) confirmBtn.disabled = false;
                    });
                });

                if (confirmBtn) {
                    confirmBtn.addEventListener('click', async () => {
                        if (!selectedBuyerId) return;
                        const listingId = confirmBtn.getAttribute('data-listing-id');
                        confirmBtn.disabled = true;

                        const response = await fetch('/Listing/MarkAsSold', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: 'listingId=' + listingId + '&buyerId=' + selectedBuyerId
                        });

                        if (response.ok) {
                            location.reload();
                        } else {
                            confirmBtn.disabled = false;
                            alert('Could not mark as sold.');
                        }
                    });
                }
            }

            // ---- favorites (srce dugme) ----
            document.querySelectorAll('.c2d-fav-btn').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const listingId = btn.getAttribute('data-listing-id');

                    const response = await fetch('/Listing/Favorites', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: 'listingId=' + listingId
                    });

                    if (!response.ok) return;

                    const data = await response.json();
                    const heart = btn.querySelector('svg');

                    if (data.isFavorited) {
                        btn.classList.add('is-saved');
                        heart.setAttribute('fill', 'currentColor');
                    } else {
                        btn.classList.remove('is-saved');
                        heart.setAttribute('fill', 'none');
                    }
                });
            });
        })();
    </script>
}