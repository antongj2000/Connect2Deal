@using System.Security.Claims
@using Connect2Deal.Constants
@model Connect2Deal.ViewModels.UpdateProfileDetails
@{
    var currentLanguage = ViewData["PreferredLanguage"] as string ?? "en";
    ViewData["Title"] = "Settings";
    ViewData["HideChrome"] = true;
    ViewData["ActivePage"] = "Settings";
    var currentImage = User.FindFirstValue("ProfileImage");
    var username = User.Identity?.Name ?? "";
}
<div class="c2d-shell" id="c2dShell">
    <partial name="_Sidebar" />
    <main class="c2d-main">
        <header class="c2d-topbar">
            <div class="c2d-topbar-left">
                <button class="c2d-burger" id="c2dBurger" aria-label="Toggle menu">
                    <span></span><span></span><span></span>
                </button>
                <div>
                    <h1 class="c2d-title">Settings</h1>
                    <p class="c2d-subtitle">Manage your account</p>
                </div>
            </div>
        </header>

        @if (TempData["SettingsSuccess"] != null)
        {
            <div class="c2d-alert is-success">@TempData["SettingsSuccess"]</div>
        }
        @if (TempData["SettingsError"] != null)
        {
            <div class="c2d-alert is-error">@TempData["SettingsError"]</div>
        }

        <div class="c2d-settings-grid">

            <div class="c2d-settings-card">
                <h2 class="c2d-settings-heading">Profile picture</h2>

                <form asp-controller="Account" asp-action="UploadProfileImage"
                      method="post" enctype="multipart/form-data" id="avatarForm">
                    <div class="c2d-avatar-row">
                        @if (!string.IsNullOrEmpty(currentImage))
                        {
                            <img class="c2d-avatar-preview" id="avatarPreview" src="@currentImage" alt="@username" />
                        }
                        else
                        {
                            <span class="c2d-avatar-fallback" id="avatarFallback">
                                @(username.Length > 0 ? username.Substring(0, 1).ToUpper() : "?")
                            </span>
                            <img class="c2d-avatar-preview is-hidden" id="avatarPreview" alt="" />
                        }
                        <div class="c2d-avatar-actions">
                            <label class="c2d-file-label" for="avatarInput">Choose image</label>
                            <input type="file" name="image" id="avatarInput" accept="image/*" class="c2d-file-input" />
                            <div class="c2d-file-hint">JPG, PNG or WEBP — max 5 MB</div>
                        </div>
                    </div>
                    <button type="submit" class="c2d-settings-submit">Save picture</button>
                </form>
            </div>

            <div class="c2d-settings-card c2d-settings-tall">
                <h2 class="c2d-settings-heading">Profile details</h2>

                <form asp-controller="Account" asp-action="UpdateProfile" method="post">

                    <div class="c2d-settings-field">
                        <label asp-for="FirstName">First name</label>
                        <input asp-for="FirstName" />
                        <span asp-validation-for="FirstName" class="c2d-field-error"></span>
                    </div>

                    <div class="c2d-settings-field">
                        <label asp-for="LastName">Last name</label>
                        <input asp-for="LastName" />
                        <span asp-validation-for="LastName" class="c2d-field-error"></span>
                    </div>

                    <div class="c2d-settings-field">
                        <label asp-for="PhoneNumber">Phone number</label>
                        <input asp-for="PhoneNumber" placeholder="+382 …" />
                        <span asp-validation-for="PhoneNumber" class="c2d-field-error"></span>
                    </div>

                    <div class="c2d-settings-field">
                        <label asp-for="Description">About you</label>
                        <textarea asp-for="Description" rows="5" maxlength="500"
                                  placeholder="Tell buyers a bit about yourself"></textarea>
                        <span asp-validation-for="Description" class="c2d-field-error"></span>
                    </div>

                    <button type="submit" class="c2d-settings-submit">Save details</button>
                </form>
            </div>

            <div class="c2d-settings-card">
                <h2 class="c2d-settings-heading">Change password</h2>

                <form asp-controller="Account" asp-action="ChangePassword" method="post">

                    <div class="c2d-settings-field">
                        <label for="CurrentPassword">Current password</label>
                        <input type="password" id="CurrentPassword" name="CurrentPassword" required />
                    </div>

                    <div class="c2d-settings-field">
                        <label for="NewPassword">New password</label>
                        <input type="password" id="NewPassword" name="NewPassword" minlength="6" required />
                    </div>

                    <div class="c2d-settings-field">
                        <label for="ConfirmPassword">Confirm new password</label>
                        <input type="password" id="ConfirmPassword" name="ConfirmPassword" minlength="6" required />
                    </div>

                    <button type="submit" class="c2d-settings-submit">Change password</button>
                </form>
            </div>

            <div class="c2d-settings-card">
                <h2 class="c2d-settings-heading">Language</h2>

                <form asp-controller="Account" asp-action="UpdateLanguage" method="post">

                    <div class="c2d-settings-field">
                        <label for="preferredLanguage">Preferred language</label>
                        <select id="preferredLanguage" name="preferredLanguage">
                            @foreach (var lang in Languages.All)
                            {
                                <option value="@lang.Key" selected="@(currentLanguage == lang.Key)">@lang.Value</option>
                            }
                        </select>
                        <div class="c2d-file-hint">
                            Messages written in another language will show a Translate button.
                        </div>
                    </div>

                    <button type="submit" class="c2d-settings-submit">Save language</button>
                </form>
            </div>

        </div>
    </main>
</div>
@section Scripts {
    <script>
        (function () {
            const input = document.getElementById('avatarInput');
            const preview = document.getElementById('avatarPreview');
            const fallback = document.getElementById('avatarFallback');
            input.addEventListener('change', function () {
                const file = input.files[0];
                if (!file) return;
                preview.src = URL.createObjectURL(file);
                preview.classList.remove('is-hidden');
                if (fallback) fallback.classList.add('is-hidden');
            });
        })();
    </script>
}