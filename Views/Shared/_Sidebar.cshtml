@*
    Shared dashboard sidebar.
    Set ViewData["ActivePage"] in each page to highlight the right nav item:
      "Marketplace" | "Messages" | "MyListings" | "Saved" | "Explore" | "Settings"
*@
@using System.Security.Claims
@{
    var activePage = ViewData["ActivePage"] as string ?? "";
    var isAuth = User.Identity != null && User.Identity.IsAuthenticated;
    var username = isAuth ? User.Identity.Name : "";
    var profileImage = isAuth ? User.FindFirstValue("ProfileImage") : null;
}
<!-- click-catcher behind the sidebar on small screens -->
<div class="c2d-overlay" id="c2dOverlay"></div>
<aside class="c2d-sidebar">
    <div class="c2d-brand">
        @if (isAuth)
        {
            @if (!string.IsNullOrEmpty(profileImage))
            {
                <img class="c2d-brand-avatar-img" src="@profileImage" alt="@username" />
            }
            else
            {
                <span class="c2d-brand-avatar">@username.Substring(0, 1).ToUpper()</span>
            }
            <div>
                <div class="c2d-brand-name">@username</div>
                <div class="c2d-brand-tag">Buy &amp; sell, locally</div>
            </div>
        }
        else
        {
            <span class="c2d-brand-mark"></span>
            <div>
                <div class="c2d-brand-name">Connect2Deal</div>
                <div class="c2d-brand-tag">Buy &amp; sell, locally</div>
            </div>
        }
    </div>
    <nav class="c2d-nav">
        <div class="c2d-nav-label">Browse</div>
        <a class="c2d-nav-item @(activePage == "Marketplace" ? "is-active" : "")"
           asp-controller="Home" asp-action="Index">
            <span class="c2d-nav-ico">▤</span> Marketplace
        </a>
        <a class="c2d-nav-item" href="#" data-soon="true">
            <span class="c2d-nav-ico">◎</span> Explore <span class="c2d-soon">soon</span>
        </a>
        @if (isAuth)
        {
            <a class="c2d-nav-item @(activePage == "Saved" ? "is-active" : "")"
               asp-controller="Home" asp-action="Index" asp-route-favorites="true">
                <span class="c2d-nav-ico">⚑</span> Saved
            </a>
        }
        else
        {
            <a class="c2d-nav-item" href="#" data-soon="true">
                <span class="c2d-nav-ico">⚑</span> Saved <span class="c2d-soon">soon</span>
            </a>
        }
        @if (isAuth)
        {
            <div class="c2d-nav-label">My account</div>
            <a class="c2d-nav-item" asp-controller="Listing" asp-action="CreateListing">
                <span class="c2d-nav-ico">＋</span> Post a listing
            </a>
            <a class="c2d-nav-item @(activePage == "MyListings" ? "is-active" : "")"
               asp-controller="Home" asp-action="Index" asp-route-mylistings="true">
                <span class="c2d-nav-ico">▦</span> My listings
            </a>
            <a class="c2d-nav-item @(activePage == "Messages" ? "is-active" : "")"
               asp-controller="Chat" asp-action="Inbox">
                <span class="c2d-nav-ico">✉</span> Messages
            </a>

            <a class="c2d-nav-item @(activePage == "Notification" ? "is-active" : "")"
               asp-controller="Notification" asp-action="Notification">
                <span class="c2d-nav-ico">✉</span> Notification
            </a>

            <a class="c2d-nav-item" href="#" data-soon="true">
                <span class="c2d-nav-ico">⚙</span> Settings <span class="c2d-soon">soon</span>
            </a>
        }
    </nav>
    <div class="c2d-sidebar-foot">
        @if (isAuth)
        {
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                <button type="submit" class="c2d-nav-item c2d-logout">
                    <span class="c2d-nav-ico">→</span> Log out
                </button>
            </form>
        }
        else
        {
            <a class="c2d-nav-item" asp-controller="Account" asp-action="Login">
                <span class="c2d-nav-ico">→</span> Log in
            </a>
        }
        <div class="c2d-copy">© 2026 Connect2Deal</div>
    </div>
</aside>