@model List<Connect2Deal.Models.Conversation>
@{
    int sellerId = (int)ViewBag.SellerId;
    int listingId = (int)ViewBag.ListingId;
    bool isService = ViewBag.IsService ?? false;
    var existingBuyerIds = ViewBag.ExistingBuyerIds as List<int> ?? new List<int>();

    var candidates = Model
        .Select(c => c.User1Id == sellerId ? c.User2 : c.User1)
        .Where(u => u != null && !existingBuyerIds.Contains(u.Id))
        .ToList();
}

<div class="c2d-buyer-pick">

    <h3 class="c2d-buyer-title">@(isService ? "Select client" : "Select buyer")</h3>
    <p class="c2d-buyer-sub">
        @(isService
                ? "Choose the person who used this service. The listing stays active, so you can confirm more clients later."
                : "Choose the person who bought this listing.")
    </p>

    @if (!candidates.Any())
    {
        <div class="c2d-buyer-empty">
            @if (!Model.Any())
            {
                @:You don't have any conversations yet, so there's no one to pick.
            }
            else
            {
                @:Everyone you have talked to about this listing has already been confirmed.
            }
        </div>
    }
    else
    {
        <div class="c2d-buyer-list">
            @foreach (var other in candidates)
            {
                <button type="button" class="c2d-buyer-item" data-buyer-id="@other.Id">
                    @if (!string.IsNullOrEmpty(other.ProfileImage))
                    {
                        <img class="c2d-buyer-avatar" src="@other.ProfileImage" alt="@other.Username" />
                    }
                    else
                    {
                        <span class="c2d-buyer-avatar">@other.Username.Substring(0, 1).ToUpper()</span>
                    }
                    <span class="c2d-buyer-name">@other.Username</span>
                    <span class="c2d-buyer-check">✓</span>
                </button>
            }
        </div>

        <button type="button" class="c2d-buyer-confirm" id="c2dBuyerConfirm"
                data-listing-id="@listingId" disabled>
            @(isService ? "Confirm completion" : "Confirm sale")
        </button>
    }
</div>