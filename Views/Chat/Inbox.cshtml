@using System.Security.Claims
@model List<Connect2Deal.Models.Conversation>
@{
    ViewData["Title"] = "Messages";
    ViewData["HideChrome"] = true;
    ViewData["ActivePage"] = "Messages";
    int myId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
    var unread = ViewData["Unread"] as Dictionary<int, int> ?? new();
}
<div class="c2d-shell" id="c2dShell">
    <partial name="_Sidebar" />
    <main class="c2d-main">
        <header class="c2d-topbar">
            <div class="c2d-topbar-left">
                <button class="c2d-burger" id="c2dBurger" aria-label="Toggle menu">
                    <span></span><span></span><span></span>
                </button>
                <div>
                    <h1 class="c2d-title">Messages</h1>
                    <p class="c2d-subtitle">Your conversations with buyers and sellers.</p>
                </div>
            </div>
        </header>
        <div class="c2d-section-head">
            <h2 class="c2d-section-title">Conversations</h2>
            <span class="c2d-count">@Model.Count total</span>
        </div>
        @if (!Model.Any())
        {
            <div class="c2d-empty">
                <div class="c2d-empty-mark">✉</div>
                <h3>No messages yet</h3>
                <p>When you message a seller about a listing, the conversation shows up here.</p>
                <a class="c2d-cta" asp-controller="Home" asp-action="Index">
                    <span>▤</span> Browse listings
                </a>
            </div>
        }
        else
        {
            <div class="c2d-inbox-list">
                @foreach (var conv in Model)
                {
                    var otherUser = conv.User1Id == myId ? conv.User2 : conv.User1;
                    var name = otherUser?.Username ?? "Unknown";
                    var initial = name.Substring(0, 1).ToUpper();
                    var when = conv.LastMessageAt?.ToString("dd MMM, HH:mm") ?? "No messages yet";
                    var unreadCount = unread.GetValueOrDefault(conv.Id, 0);
                    <a class="c2d-inbox-item"
                       data-conv-id="@conv.Id"
                       asp-controller="Chat" asp-action="Conversation" asp-route-id="@conv.Id">
                        @if (!string.IsNullOrEmpty(otherUser?.ProfileImage))
                        {
                            <img class="c2d-inbox-avatar" src="@otherUser.ProfileImage" alt="@name" />
                        }
                        else
                        {
                            <div class="c2d-inbox-avatar">@initial</div>
                        }
                        <div class="c2d-inbox-info">
                            <div class="c2d-inbox-name @(unreadCount > 0 ? "is-unread" : "")">@name</div>
                            <div class="c2d-inbox-preview">@when</div>
                        </div>
                        @if (unreadCount > 0)
                        {
                            <span class="c2d-inbox-badge">@unreadCount</span>
                        }
                        <span class="c2d-inbox-time">›</span>
                    </a>
                }
            </div>
        }
    </main>
</div>
@section Scripts {
    <script>
        window.c2dReady.then(function () {
            window.c2dConnection.on("InboxUpdate", function (msg) {
                var row = document.querySelector('[data-conv-id="' + msg.conversationId + '"]');
                if (!row) return;

                var badge = row.querySelector('.c2d-inbox-badge');
                if (badge) {
                    badge.textContent = parseInt(badge.textContent) + 1;
                } else {
                    badge = document.createElement('span');
                    badge.className = 'c2d-inbox-badge';
                    badge.textContent = '1';
                    var arrow = row.querySelector('.c2d-inbox-time');
                    row.insertBefore(badge, arrow);
                }

                var name = row.querySelector('.c2d-inbox-name');
                if (name) name.classList.add('is-unread');
            });
        });
    </script>
}