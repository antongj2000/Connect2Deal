@model Connect2Deal.ViewModels.Listing

@{
    bool isEdit = Model.Id > 0;

    ViewData["Title"] = isEdit ? "Edit listing" : "Post a listing";
    ViewData["HideChrome"] = true;
    ViewData["ActivePage"] = "";
}

<div class="c2d-shell" id="c2dShell">

    <partial name="_Sidebar" />

    <main class="c2d-main">

        <header class="c2d-topbar">
            <div class="c2d-topbar-left">
                <button class="c2d-burger" id="c2dBurger" aria-label="Toggle menu">
                    <span></span><span></span><span></span>
                </button>
                <div>
                    <h1 class="c2d-title">@(isEdit ? "Edit listing" : "Post a listing")</h1>
                    <p class="c2d-subtitle">
                        @(isEdit
                                                ? "Update the details of your listing. Photos cannot be changed here."
                                                : "Fill in the details — your item goes live for 10 days.")
                    </p>
                </div>
            </div>
        </header>

        <div class="c2d-form-wrap">
            <div class="c2d-card">

                <form asp-action="@(isEdit ? "EditListing" : "CreateListing")" method="post" enctype="multipart/form-data">

                    @if (isEdit)
                    {
                        <input type="hidden" asp-for="Id" />
                    }

                    <div class="c2d-form-section">
                        <div class="c2d-form-section-title">Basic info</div>

                        <div class="mb-3">
                            <label asp-for="Title" class="c2d-form-label"></label>
                            <input asp-for="Title" class="c2d-form-input" placeholder="e.g. iPhone 17 Pro Max, 256GB" />
                            <span asp-validation-for="Title" class="c2d-field-error"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ParentCategory" class="c2d-form-label"></label>
                                <select asp-for="ParentCategory"
                                        asp-items="Model.ParentCategories"
                                        id="parentCategory"
                                        class="c2d-form-input">
                                    <option value="">Choose a category</option>
                                </select>
                                <span asp-validation-for="ParentCategory" class="c2d-field-error"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ChildCategory" class="c2d-form-label"></label>
                                <select asp-for="ChildCategory"
                                        asp-items="Model.ChildCategories"
                                        id="childCategory"
                                        class="c2d-form-input">
                                    <option value="">Choose a category first</option>
                                </select>
                                <span asp-validation-for="ChildCategory" class="c2d-field-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="c2d-form-section">
                        <div class="c2d-form-section-title">Location</div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Country" class="c2d-form-label"></label>
                                <select asp-for="Country"
                                        asp-items="Model.Countries"
                                        id="country"
                                        class="c2d-form-input">
                                    <option value="">Choose a country</option>
                                </select>
                                <span asp-validation-for="Country" class="c2d-field-error"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="City" class="c2d-form-label"></label>
                                <select asp-for="City"
                                        asp-items="Model.Cities"
                                        id="city"
                                        class="c2d-form-input">
                                    <option value="">Choose a country first</option>
                                </select>
                                <span asp-validation-for="City" class="c2d-field-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="c2d-form-section">
                        <div class="c2d-form-section-title">Price and description</div>

                        <div class="mb-3">
                            <label asp-for="Price" class="c2d-form-label"></label>
                            <div class="c2d-price-wrap">
                                <input asp-for="Price" class="c2d-form-input" placeholder="0.00" />
                                <span class="c2d-price-suffix">€</span>
                            </div>
                            <span asp-validation-for="Price" class="c2d-field-error"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Description" class="c2d-form-label"></label>
                            <textarea asp-for="Description"
                                      class="c2d-form-input"
                                      rows="6"
                                      placeholder="Condition, age, what's included..."></textarea>
                            <span asp-validation-for="Description" class="c2d-field-error"></span>
                        </div>
                    </div>

                    @if (!isEdit)
                    {
                        <div class="c2d-form-section">
                            <div class="c2d-form-section-title">Photos</div>

                            <div class="image-upload-box" id="dropZone">
                                <input type="file"
                                       id="imageInput"
                                       name="images"
                                       multiple
                                       accept="image/*"
                                       hidden />
                                <div class="upload-content">
                                    <div style="font-size:2rem; line-height:1; color:#a8adc0;">⬆</div>
                                    <p class="mb-1">
                                        <strong>Click to upload</strong> or drag images here
                                    </p>
                                    <small class="text-muted">PNG, JPG up to 5MB each</small>
                                </div>
                            </div>

                            <div id="previewContainer" class="image-preview-container mt-3"></div>
                        </div>
                    }

                    <div class="c2d-form-actions">
                        <button type="submit" class="c2d-form-submit">
                            @(isEdit ? "Save changes" : "Publish listing")
                        </button>
                        <a asp-controller="Home" asp-action="Index"
                           asp-route-mylistings="@(isEdit ? "true" : null)"
                           class="c2d-form-cancel">Cancel</a>
                    </div>

                </form>

            </div>
        </div>

    </main>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        // CATEGORY + LOCATION DROPDOWNS
        function chain(parentId, childId, url) {
            const parent = document.getElementById(parentId);
            const child = document.getElementById(childId);

            async function load(parentValue, selectedId = null) {
                child.innerHTML = '<option value="">Choose</option>';

                if (!parentValue) {
                    child.disabled = true;
                    return;
                }

                const response = await fetch(`${url}?parentId=${parentValue}`);
                const items = await response.json();

                items.forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item.id;
                    opt.textContent = item.name;
                    if (selectedId && item.id == selectedId) {
                        opt.selected = true;
                    }
                    child.appendChild(opt);
                });

                child.disabled = false;
            }

            parent.addEventListener('change', () => {
                load(parent.value);
            });

            if (parent.value) {
                load(parent.value, child.value);
            }
        }

        chain('parentCategory', 'childCategory', '/Listing/SubCategories');
        chain('country', 'city', '/Listing/Cities');

        // IMAGE UPLOAD (samo pri kreiranju novog oglasa)
        const dropZone = document.getElementById("dropZone");

        if (dropZone) {
            const imageInput = document.getElementById("imageInput");
            const previewContainer = document.getElementById("previewContainer");

            dropZone.addEventListener("click", () => {
                imageInput.click();
            });

            imageInput.addEventListener("change", () => {
                showPreview(imageInput.files);
            });

            dropZone.addEventListener("dragover", e => {
                e.preventDefault();
                dropZone.classList.add("is-dragging");
            });

            dropZone.addEventListener("dragleave", () => {
                dropZone.classList.remove("is-dragging");
            });

            dropZone.addEventListener("drop", e => {
                e.preventDefault();
                dropZone.classList.remove("is-dragging");
                imageInput.files = e.dataTransfer.files;
                showPreview(e.dataTransfer.files);
            });

            function showPreview(files) {
                previewContainer.innerHTML = "";

                [...files].forEach(file => {
                    if (!file.type.startsWith("image/")) return;

                    const reader = new FileReader();
                    reader.onload = e => {
                        const img = document.createElement("img");
                        img.src = e.target.result;
                        img.className = "image-preview";
                        previewContainer.appendChild(img);
                    };
                    reader.readAsDataURL(file);
                });
            }
        }

        // ENABLE SELECTS BEFORE SUBMIT
        document.querySelector("form").addEventListener("submit", function () {
            document.getElementById("childCategory").disabled = false;
            document.getElementById("city").disabled = false;
        });
    </script>
}